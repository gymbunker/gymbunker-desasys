# Database Connection (Neon PostgreSQL)
DATABASE_URL=postgresql://usuario:password@host/neondb?sslmode=require&channel_binding=require

# Optional: set to true if local webcam should auto-start on server launch
LOCAL_CAMERA=false

# WhatsApp Business / Sender Phone Number (Ejemplo: +549XXXXXXXXXX)
WHATSAPP_PHONE=+549XXXXXXXXXX
VITE_WHATSAPP_PHONE=+549XXXXXXXXXX

# Pasarela para envíos automáticos silenciosos (Opción 1: UltraMsg / Whapi / Evolution QR)
# WHATSAPP_GATEWAY_URL=https://api.ultramsg.com/instanceXXXX/messages/chat
# WHATSAPP_API_TOKEN=tu_token_aqui

# Pasarela para envíos automáticos silenciosos (Opción 2: Meta Cloud API Oficial)
# WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
# WHATSAPP_META_TOKEN=tu_access_token_de_meta
# Vercel Blob Storage para documentos de planes (PDF/DOCX)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
